# ==============================================================================
# AI Customer Support Agent - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and populate with your local credentials and settings.
# Do NOT commit .env to version control.

# --- Kaggle API Credentials ---
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-key

# --- LLM API Providers ---
# Supported providers: openai, anthropic, google, or mock
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_API_KEY=your-gemini-api-key-here

# --- Model Configurations ---
AGENT_MODEL_NAME=gpt-4o-mini
JUDGE_MODEL_NAME=gpt-4o
TEMPERATURE=0.1
MAX_TOKENS=512

# --- Embedding & Vector Store ---
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_STORE_PATH=./data/processed/chroma_db
RETRIEVAL_TOP_K=3
RETRIEVAL_SIMILARITY_THRESHOLD=0.70

# --- Agent Escalation Thresholds ---
CONFIDENCE_THRESHOLD=0.65
ENABLE_GROUNDING_GUARDRAIL=true

# --- Logging & Tracing ---
LOG_LEVEL=INFO
ENABLE_TRACING=false
